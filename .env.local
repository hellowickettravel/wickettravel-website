# Local development only — this file is gitignored (.gitignore: `.env*`).
#
# Points the Assist Family read relay (app/api/parent-ticket/public/route.ts)
# at the portal dev server instead of the production deployment, whose
# endpoint currently 404s. Without this the board renders its error state.
PORTAL_PUBLIC_ENDPOINT=http://localhost:3200/api/parent-ticket/public
