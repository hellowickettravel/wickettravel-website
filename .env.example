# Wicket Travel — website environment variables.
#
# Copy to .env.local for development. Every one of these is OPTIONAL: the app
# runs with none of them set, using the defaults compiled into lib/links.ts.
# None is a secret in the sense of granting access — the portal endpoints are
# public and validate server-side — but see WICKET_RELAY_SECRET below.
#
# NOTE: .gitignore matches `.env*`, so this file must be force-added
# (`git add -f .env.example`) to be committed. That is deliberate: the ignore
# rule is what stops a real .env.local being pushed by accident.

# ---------------------------------------------------------------------------
# Where the booking portal lives.
# ---------------------------------------------------------------------------
# Overrides the compiled-in origin for ALL THREE server-side relays at once
# (Assist Family intake, the public board feed, and the Dubai visa intake).
# Set it to the portal dev server to develop against local data:
#
#   PORTAL_ORIGIN=http://localhost:3200
#
# Must be an ORIGIN, not a URL with a path — anything unparseable is ignored
# and the compiled-in value is used, so a typo degrades rather than breaks.
# Deliberately NOT prefixed NEXT_PUBLIC_: it must stay server-side, so the
# relay remains the only thing that talks to the portal.
# PORTAL_ORIGIN=https://portal.wickettravel.com

# Legacy, read-path only: a FULL URL for the public board feed. Overrides
# PORTAL_ORIGIN for that one endpoint. Prefer PORTAL_ORIGIN unless you
# genuinely need the read and write paths pointing at different places.
# PORTAL_PUBLIC_ENDPOINT=http://localhost:3200/api/parent-ticket/public

# ---------------------------------------------------------------------------
# Rate-limiting identity.  ** SET THIS IN PRODUCTION. **
# ---------------------------------------------------------------------------
# Must equal the portal's VISA_RELAY_SECRET. It proves to the portal that a
# forwarded client IP came from our relay, which is the only way the portal
# will honour it — the host overwrites an inbound x-forwarded-for with the
# connecting IP, so the header alone carries no trust.
#
# WITHOUT IT the portal buckets every visitor of this site under the relay's
# single egress IP: 8 accepted submissions per 15 minutes and 25 per day, for
# the entire world. Genuine leads start getting 429s on any busy day.
#
# Generate with:  openssl rand -base64 32
# WICKET_RELAY_SECRET=

# ---------------------------------------------------------------------------
# Search engine ownership verification.
# ---------------------------------------------------------------------------
# Only the token, not the whole meta tag. Google Search Console >
# Add property > URL prefix > HTML tag gives you
#   <meta name="google-site-verification" content="THIS_PART_ONLY" />
#
# These two ARE NEXT_PUBLIC_ on purpose — a verification token is meant to be
# readable in the page source; that is how verification works. It proves
# control of the site, it grants nothing.
#
# Prefer DNS TXT verification if you control the domain: it survives
# redeploys and covers every subdomain and protocol at once.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Website forms (contact, quote, deal-email sign-up) — /api/contact.
# ---------------------------------------------------------------------------
# Submissions are emailed to the team through Resend (resend.com). Without
# RESEND_API_KEY the forms still work for visitors: they get WhatsApp and a
# pre-filled email instead of a silent failure. The FROM address must be on a
# domain verified in Resend (add wickettravel.com there first).
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=info@wickettravel.com
# CONTACT_FROM_EMAIL=Wicket Travel website <forms@wickettravel.com>

# ---------------------------------------------------------------------------
# Optional tools behind the cookie banner (components/CookieConsent.tsx).
# ---------------------------------------------------------------------------
# Each loads ONLY after the visitor allows its cookie category. If you add a
# new tool, add it to app/cookie-policy/page.tsx and bump CONSENT_VERSION in
# lib/consent.ts so everyone is asked again.
#
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Unset = no analytics.
# NEXT_PUBLIC_GA_ID=
# Trustpilot TrustBox business unit ID (Trustpilot Business > Integrations >
# TrustBox). Unset = the footer shows the static "Rated Excellent" badge.
# NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
